{
  "/users/login": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/users/login$": "/login"
    }
  },
  "/users": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/users/(.*)$": "/$1"
    }
  },
  "/questions/count": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/questions/count$": "/count"
    }
  },
  "/questions": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/questions/[^/]+/errors$": "/errors"
    }
  },
  "/quizzes": {
    "target": "http://localhost:3000",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/quizzes/(.*)$": "/$1"
    }
  }
}
